[gd_resource type="Resource" script_class="AlleyCatControls" format=3]

[ext_resource type="Script" path="res://addons/godot_alleycat_gdextension/scripts/alley_cat_controls.gd" id="1_controls"]
[ext_resource type="Script" path="res://addons/godot_alleycat_gdextension/scripts/alley_cat_control.gd" id="2_control"]

[sub_resource type="Resource" id="Resource_move"]
script = ExtResource("2_control")
label = "Move the cat"
keyboard = "Cursor keys"
xbox = "Left stick, D-pad"
nintendo = "Left stick, D-pad"
playstation = "Left stick, D-pad"

[sub_resource type="Resource" id="Resource_climb"]
script = ExtResource("2_control")
label = "Climb the fence"
keyboard = "Up, Down"
xbox = "Push up or down"
nintendo = "Push up or down"
playstation = "Push up or down"

[sub_resource type="Resource" id="Resource_jump"]
script = ExtResource("2_control")
label = "Jump, act"
keyboard = "Alt"
xbox = "A"
nintendo = "B"
playstation = "Cross"

[sub_resource type="Resource" id="Resource_sound"]
script = ExtResource("2_control")
label = "Sound on, off"
keyboard = "Ctrl-S"
xbox = "B"
nintendo = "A"
playstation = "Circle"

[sub_resource type="Resource" id="Resource_menu"]
script = ExtResource("2_control")
label = "Back to the menu"
keyboard = "Ctrl-M"
xbox = "Start"
nintendo = "+"
playstation = "Options"

[sub_resource type="Resource" id="Resource_pause"]
script = ExtResource("2_control")
label = "Paws mode"
keyboard = "Esc"
xbox = "Back"
nintendo = "-"
playstation = "Share"

[sub_resource type="Resource" id="Resource_restart"]
script = ExtResource("2_control")
label = "Restart"
keyboard = "Ctrl-R"

[sub_resource type="Resource" id="Resource_yes"]
script = ExtResource("2_control")
label = "Yes, then Kitten"
keyboard = "Y, then K"
xbox = "A"
nintendo = "B"
playstation = "Cross"

[sub_resource type="Resource" id="Resource_no"]
script = ExtResource("2_control")
label = "No, then House Cat"
keyboard = "N, then H"
xbox = "B"
nintendo = "A"
playstation = "Circle"

[sub_resource type="Resource" id="Resource_tomcat"]
script = ExtResource("2_control")
label = "Tomcat"
keyboard = "T"
xbox = "X"
nintendo = "Y"
playstation = "Square"

[sub_resource type="Resource" id="Resource_alleycat"]
script = ExtResource("2_control")
label = "Alley Cat"
keyboard = "A"
xbox = "Y"
nintendo = "X"
playstation = "Triangle"

[sub_resource type="Resource" id="Resource_begin"]
script = ExtResource("2_control")
label = "Start playing"
keyboard = "Any key"
xbox = "A"
nintendo = "B"
playstation = "Cross"

[resource]
script = ExtResource("1_controls")
movement = Array[ExtResource("2_control")]([SubResource("Resource_move"), SubResource("Resource_climb")])
actions = Array[ExtResource("2_control")]([SubResource("Resource_jump"), SubResource("Resource_sound"), SubResource("Resource_menu"), SubResource("Resource_pause"), SubResource("Resource_restart")])
setup = Array[ExtResource("2_control")]([SubResource("Resource_yes"), SubResource("Resource_no"), SubResource("Resource_tomcat"), SubResource("Resource_alleycat"), SubResource("Resource_begin")])
