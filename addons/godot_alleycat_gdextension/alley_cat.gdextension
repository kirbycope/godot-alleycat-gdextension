[configuration]

entry_symbol = "alley_cat_library_init"
compatibility_minimum = "4.8"

[libraries]

windows.debug.x86_64 = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.windows.template_release.x86_64.dll"
macos.debug = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.macos.template_debug.framework"
macos.release = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.macos.template_release.framework"
web.debug.wasm32.nothreads = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.web.template_release.wasm32.nothreads.wasm"
web.release.wasm32.nothreads = "res://addons/godot_alleycat_gdextension/bin/liballey_cat.web.template_release.wasm32.nothreads.wasm"
