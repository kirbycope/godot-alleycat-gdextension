# godot-cpp is cloned, not vendored. See the README.
godot-cpp/

# The game is not ours to distribute. Bring your own CAT.EXE.
*.EXE
addons/godot_alleycat_gdextension/assets/*.exe

# Dumped from the engine you build against; regenerate it rather than commit 7 MB.
extension_api.json

# Build intermediates. The built libraries in addons/.../bin are committed on purpose, so a
# consumer can install the addon without a toolchain.
*.obj
*.os
*.o
*.lib
*.exp
*.pdb
*.ilk
.sconsign.dblite
.sconf_temp/
config.log

.godot/
.mcp/

# Build and import logs
build.log
import.log
# MSVC leaves ~-prefixed temporaries beside the linked output.
~*
# Godot metadata for build intermediates; src/.gdignore stops these being made now.
src/*.import
